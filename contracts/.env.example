# Copy to .env (same folder) and fill in. .env is gitignored: never commit or share it.

# Pays the deploy gas. Needs a little ETH on Robinhood Chain. Has no power after deploy.
DEPLOYER_PRIVATE_KEY=

# Your own wallet that controls the registry (add/remove publishers, pause). Address only.
OWNER_ADDRESS=

# Address of the separate key Elyperp's server publishes scans with. Address only here;
# its private key goes into Vercel as ELYPERP_PUBLISHER_KEY.
PUBLISHER_ADDRESS=

# Optional: your own RPC URL. Defaults to https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL=
