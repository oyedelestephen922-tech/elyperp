# Hyperliquid network: "testnet" (default, safe) or "mainnet"
NEXT_PUBLIC_HL_NETWORK=testnet

# Elysium (Kinetiq) — defaults target Elysium Testnet (chain 99801).
# For mainnet, fill these from Kinetiq's official docs once published.
NEXT_PUBLIC_ELYSIUM_CHAIN_ID=99801
NEXT_PUBLIC_ELYSIUM_CHAIN_NAME=Elysium Testnet
NEXT_PUBLIC_ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
NEXT_PUBLIC_ELYSIUM_EXPLORER_URL=https://explorer-elysium-testnet.t.conduit.xyz

# Optional: enables WalletConnect (get one at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Only for scripts/testnet-trade.ts — a THROWAWAY testnet key. Never commit, never use a funded mainnet key.
# TESTNET_PRIVATE_KEY=
