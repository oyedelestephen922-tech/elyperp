# Nothing here is required. Markets and trading work with an empty env.

# Optional builder fee. Only applies to Lighter Plus/Premium accounts that approve it.
# Fee units: 1,000,000 = 100%, so 25 = 0.0025%.
NEXT_PUBLIC_LIGHTER_INTEGRATOR_INDEX=
NEXT_PUBLIC_LIGHTER_INTEGRATOR_TAKER_FEE=
NEXT_PUBLIC_LIGHTER_INTEGRATOR_MAKER_FEE=

# Optional: enables WalletConnect (get one at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: a private Robinhood Chain RPC (the public one is rate-limited)
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional: social links shown in the site footer (full https URLs)
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
