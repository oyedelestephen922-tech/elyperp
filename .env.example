# Orderly builder ID (broker_id) from https://dex.orderly.network.
# Market data works without it; account creation, deposits and trading need it.
NEXT_PUBLIC_ORDERLY_BROKER_ID=

# Optional: enables WalletConnect (get one at https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: a private Robinhood Chain RPC (the public one is rate-limited)
# NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
